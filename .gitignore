# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Node.js
node_modules/

# Slides/HTML exports - apenas código, não imágenes
slides/*/
!slides/*/*.html    # Carousel HTML
!slides/*/*.txt     # Legenda
slides_veronica/
Imagens/
Imagens
# Posts - só código e legenda; as imagens ficam em publicado/
posts/*/*.png
posts/*/*.jpg
posts/*/*.jpeg
# Documento - exceto gerenciador
Documento/*
!Documento/
!Documento/gerenciador_ideias.html

# Mídia publicada (hospedagem pública via raw.githubusercontent.com)
# NÃO ignorar: publicado/ precisa ser versionado para virar URL pública.

# Ambiente
.env
.env.*
!.env.example
.opencode/

# Segredos e credenciais — nunca versionar em repositório público
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
credentials*.json
.npmrc
.netrc
id_rsa*
id_ed25519*
*.gpg
*.asc

# Aprovação: estado interno (IDs de e-mail, histórico, mídia em revisão)
# fica só na máquina — não precisa estar no repositório público.
aprovacoes/*.json
# Aprovação: HTML do e-mail é gerado pelo aprovacao.py
aprovacoes/*-email.html
# Log do vigia de aprovação (gerado a cada verificação)
aprovacoes/vigia.log
# Trava de execução do vigia (runtime)
aprovacoes/.vigia.lock

# OS
.DS_Store
Thumbs.db
