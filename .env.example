# Copie para `.env` e preencha. NUNCA versione o `.env` preenchido.
#
# O `.env` guarda credenciais que dão acesso total ao Gmail e ao Instagram.
# Proteja o arquivo:
#     chmod 600 .env
#
# As variáveis abaixo são lidas por `composio_mcp.py` (chave do Composio).
# A chave do MCP também pode estar em ~/.config/opencode/opencode.json
# (mcp.servers.composio.headers.x-consumer-api-key) — nesse arquivo a
# permissão também precisa ser 600.

# Chave do Composio (MCP). Vai para o header x-consumer-api-key.
COMPOSIO_MCP_KEY=

# Chave da API do Composio (mesma conta, formato diferente).
COMPOSIO_API_KEY=

# E-mail que recebe e responde a aprovação dos posts.
# APROVACAO_EMAIL=veronicabomfim.nutri@gmail.com

# Remoto git esperado para o upload automático da mídia.
# GITHUB_REMOTE_ESPERADO=git@github.com:tarcisiotna/instagram_veronica.git

# Libera o fallback catbox.moe (host público de terceiros). Desligado por padrão.
# APROVACAO_ALLOW_CATBOX=1

# Conta do Instagram (ID numérico do perfil).
# IG_USER_ID=28882452441414713
